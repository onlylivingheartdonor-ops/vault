// Vault — Cloudflare configuration.
// Setup steps (see README.md) ask you to fill in three values below:
//   1. database_id   — from the D1 database you create named "vault-db"
//   2. ACCESS_TEAM   — your Cloudflare Access team domain, e.g. "https://yourname.cloudflareaccess.com"
//   3. ACCESS_AUD    — the Access "AUD tag" shown when you turn on Cloudflare Access for this Worker
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vault",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vault-db",
      "database_id": "ccf176a7-3437-4e1e-8caf-2393da5fff45"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vault-media"
    }
  ],
  "vars": {
    "ACCESS_TEAM": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
